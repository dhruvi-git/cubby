# ============================================================
#  Cubby backend settings. Copy this file to ".env" and fill it in.
#  Start with everything "local", then switch one cloud at a time
#  by following docs/SETUP_GUIDE.md.
# ============================================================

# ---------- App (Part 1) ----------
APP_ENV=local
# Paste a long random string (the guide shows how to make one)
APP_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
CRON_SECRET=
# Your email here gives you the Admin page (comma-separate several)
ADMIN_EMAILS=
DATABASE_URL=postgresql+psycopg://cubby:cubby@localhost:5432/cubby

# ---------- Keys (Part 1 local -> Part 5 azure) ----------
KEY_PROVIDER=local
LOCAL_MASTER_KEY=

# ---------- Storage (Part 1 local -> Part 4 s3 / Part 5 azure backup) ----------
STORAGE_PRIMARY=local
STORAGE_BACKUP=none
LOCAL_STORAGE_DIR=./data/files

# ---------- OCR (Part 4) ----------
OCR_PROVIDER=none

# ---------- AI (Part 2 Gemini, Part 3 Groq) ----------
LLM_PROVIDER=gemini
LLM_FALLBACK=true
GCP_PROJECT_ID=
GCP_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---------- AWS (Part 4) ----------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# ---------- Email (password resets, security alerts) ----------
# console = emails are printed in the backend logs (fine on your laptop)
EMAIL_PROVIDER=console
ACS_CONNECTION_STRING=
EMAIL_SENDER=

# ---------- Azure (Part 5) ----------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_KEY_VAULT_URL=
AZURE_KEY_NAME=cubby-master-key
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=cubby-backup
